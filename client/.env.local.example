# Knoxel client configuration
# Copy this file to .env.local and fill in the values you need.
# .env.local is gitignored — never commit it.
#
# Only set ONE of VITE_POCKETBASE_URL or VITE_WORKER_URL.
# Setting VITE_POCKETBASE_URL = multiplayer mode (PocketBase server)
# Setting VITE_WORKER_URL only = static/solo mode (Cloudflare Worker)

# ── Multiplayer mode (PocketBase) ────────────────────────────────────────────
# Point at your local PocketBase instance during development,
# or your deployed server URL in production.
# VITE_POCKETBASE_URL=http://127.0.0.1:8090

# ── Static/solo mode (Cloudflare Worker) ─────────────────────────────────────
# Used when running the GitHub Pages static build locally.
# Programs are fetched from Cloudflare by ?id= URL parameter.
# VITE_WORKER_URL=https://knoxel-worker.jspacco.workers.dev

# ── Page URL (for Java openInBrowser()) ──────────────────────────────────────
# Where the Java library should open the browser.
# Use localhost during development, GitHub Pages URL in production.
# VITE_PAGE_URL=http://localhost:5173
# VITE_PAGE_URL=https://jspacco.github.io/knoxel